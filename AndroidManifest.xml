<?xml version="1.0" encoding="utf-8"?>
<!-- QGen Android — QSP 游戏编辑器（QGen 4.3 的安卓重实现）
     格式处理逻辑参考 GPLv2+ 的 QGen (github.com/QSPFoundation/qgen)，本程序同样以 GPLv2+ 发布。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.qsp.qgen"
    android:versionCode="141"
    android:versionName="1.3.11">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 允许从文件管理器用“打开方式”直接打开 .qsp 文件 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-qsp" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:host="*" />
                <data android:scheme="content" />
                <data android:pathPattern=".*\\.qsp" />
            </intent-filter>
        </activity>
    </application>
</manifest>
